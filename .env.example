# Copy to .env in the repository root and fill only the keys you use.
# Empty values are intentional. Never commit .env or paste keys into results.

# Required for built-in ordinary model generation and all objective / expert / FACT judges.
OPENROUTER_API_KEY=

# Separate tested-model key for --model_backend openai. Optional for localhost;
# required for remote HTTPS endpoints. --model_api_key_env can select another name.
# Custom backend keys never replace OPENROUTER_API_KEY for the judges.
ICBCBENCH_MODEL_API_KEY=

# Optional providers: needed only when selecting their Deep Research models.
OPENAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
DASHSCOPE_API_KEY=

# Optional Jina Reader key for FACT scraping; local HTML/PDF fallback needs no key.
JINA_API_KEY=
