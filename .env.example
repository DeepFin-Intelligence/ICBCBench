# Copy to .env in the repository root and fill only the keys you use.
# Empty values are intentional. Never commit .env or paste keys into results.

# Required for ordinary model generation and all objective / expert / FACT judges.
OPENROUTER_API_KEY=

# Optional providers: needed only when selecting their Deep Research models.
OPENAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
DASHSCOPE_API_KEY=

# Optional Jina Reader key for FACT scraping; local HTML/PDF fallback needs no key.
JINA_API_KEY=
